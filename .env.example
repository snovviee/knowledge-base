# Copy this file to .env (Git ignores .env) and fill in the credentials. See "Environment variables" in README.md.

# Google OAuth client id, to sign in with Google.
GOOGLE_CLIENT_ID=
# Google OAuth client secret, to sign in with Google.
GOOGLE_CLIENT_SECRET=

# GitHub OAuth app client id, to sign in with GitHub.
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret, to sign in with GitHub.
GITHUB_CLIENT_SECRET=

# The address the app is served at; the sign-in callback URLs are built from it. Default: http://localhost:3000
# APP_BASE_URL=http://localhost:3000

# Signs the session cookie. Production only; development and test make their own.
# SECRET_KEY_BASE=
